# Example environment variables for Planaday Native Self-Hosted Sync Server
# Copy to deployment/.env and set a strong generated password before running docker compose up.
# NEVER commit real secrets to Git!

PLANADAY_PG_DB=planaday_native
PLANADAY_PG_USER=planaday_app
PLANADAY_PG_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
PLANADAY_BIND_ADDR=127.0.0.1
PLANADAY_HOST_PORT=8420
PLANADAY_ALLOWED_OUTBOUND_HOSTS=
